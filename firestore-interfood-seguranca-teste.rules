rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function estabelecimentoDoc() {
      return get(/databases/$(database)/documents/usuariosEstabelecimentos/$(request.auth.uid));
    }

    function estabelecimentoAtivo() {
      return signedIn()
        && estabelecimentoDoc().data.perfil == 'estabelecimento'
        && estabelecimentoDoc().data.ativo == true;
    }

    function minhaFranquiaEstabelecimento() {
      return estabelecimentoAtivo() ? estabelecimentoDoc().data.franquiaId : null;
    }

    function minhaLoja() {
      return estabelecimentoAtivo() ? estabelecimentoDoc().data.lojaId : null;
    }

    // O estabelecimento autenticado pode ler somente o proprio vinculo.
    // Escrita deste documento permanece bloqueada no cliente.
    match /usuariosEstabelecimentos/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // Estrutura de homologacao do Interfood.
    // A loja so acessa a franquia e loja gravadas no seu vinculo autenticado.
    match /franquias/{fid}/estabelecimentos/{lojaId} {
      allow read: if estabelecimentoAtivo()
        && minhaFranquiaEstabelecimento() == fid
        && minhaLoja() == lojaId;

      // Nesta primeira homologacao, alteracao do cadastro da loja fica fechada.
      allow write: if false;

      match /pedidos/{pedidoId} {
        allow read: if estabelecimentoAtivo()
          && minhaFranquiaEstabelecimento() == fid
          && minhaLoja() == lojaId;

        // Liberaremos transicoes de status em etapa separada, com validacao de campos.
        allow write: if false;
      }
    }

    // Tudo que nao foi explicitamente autorizado permanece bloqueado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
