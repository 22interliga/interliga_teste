rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function estabelecimentoDoc() {
      return get(/databases/$(database)/documents/usuariosEstabelecimentos/$(request.auth.uid));
    }

    function entregadorDoc() {
      return get(/databases/$(database)/documents/usuariosEntregadores/$(request.auth.uid));
    }

    function franqueadoDoc() {
      return get(/databases/$(database)/documents/franqueados/$(request.auth.uid));
    }

    function estabelecimentoAtivo() {
      return signedIn()
        && estabelecimentoDoc().data.perfil == 'estabelecimento'
        && estabelecimentoDoc().data.ativo == true;
    }

    function entregadorAtivo() {
      return signedIn()
        && entregadorDoc().data.perfil == 'entregador'
        && entregadorDoc().data.ativo == true;
    }

    function franqueadoAtivo() {
      return signedIn()
        && franqueadoDoc().data.perfil == 'franqueado'
        && franqueadoDoc().data.ativo == true;
    }

    function minhaFranquiaEstabelecimento() {
      return estabelecimentoAtivo() ? estabelecimentoDoc().data.franquiaId : null;
    }

    function minhaLoja() {
      return estabelecimentoAtivo() ? estabelecimentoDoc().data.lojaId : null;
    }

    function minhaFranquiaEntregador() {
      return entregadorAtivo() ? entregadorDoc().data.franquiaId : null;
    }

    function minhaFranquiaFranqueado() {
      return franqueadoAtivo() ? franqueadoDoc().data.franquiaId : null;
    }

    function souDonoDaLoja(fid, lojaId) {
      return estabelecimentoAtivo()
        && minhaFranquiaEstabelecimento() == fid
        && minhaLoja() == lojaId;
    }

    function entregadorDaFranquia(fid) {
      return entregadorAtivo() && minhaFranquiaEntregador() == fid;
    }

    function franqueadoDaFranquia(fid) {
      return franqueadoAtivo() && minhaFranquiaFranqueado() == fid;
    }

    function somenteStatusFoiAlterado() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
    }

    function transicaoStatusEstabelecimentoValida() {
      return
        ((resource.data.status == 'Novo' || resource.data.status == 'Pendente')
          && request.resource.data.status == 'Confirmado')
        || (resource.data.status == 'Confirmado'
          && request.resource.data.status == 'Em preparo')
        || (resource.data.status == 'Em preparo'
          && request.resource.data.status == 'Pronto');
    }

    function entregadorEhOAutenticado() {
      return request.resource.data.entregador.uid == request.auth.uid;
    }

    function pedidoJaEhMeu() {
      return resource.data.entregador.uid == request.auth.uid;
    }

    function transicaoEntregadorValida() {
      return
        (resource.data.status == 'Pronto'
          && request.resource.data.status == 'Entregador aceitou'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','entregador','aceitoEm'])
          && entregadorEhOAutenticado())
        || (resource.data.status == 'Entregador aceitou'
          && request.resource.data.status == 'Coletado'
          && pedidoJaEhMeu()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','coletadoEm']))
        || (resource.data.status == 'Coletado'
          && request.resource.data.status == 'Saiu para entrega'
          && pedidoJaEhMeu()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','saiuEntregaEm']))
        || (resource.data.status == 'Saiu para entrega'
          && request.resource.data.status == 'Concluído'
          && pedidoJaEhMeu()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','concluidoEm']));
    }

    function franqueadoPodeAlternarAcessoEstabelecimento() {
      return franqueadoAtivo()
        && resource.data.franquiaId == minhaFranquiaFranqueado()
        && request.resource.data.franquiaId == resource.data.franquiaId
        && request.resource.data.lojaId == resource.data.lojaId
        && request.resource.data.perfil == resource.data.perfil
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ativo'])
        && request.resource.data.ativo is bool;
    }

    function franqueadoPodeCriarEstabelecimento(fid, lojaId) {
      return franqueadoDaFranquia(fid)
        && request.resource.data.keys().hasOnly(['nome','email','ativo','franquiaId','lojaId','criadoEm'])
        && request.resource.data.nome is string
        && request.resource.data.email is string
        && request.resource.data.ativo == true
        && request.resource.data.franquiaId == fid
        && request.resource.data.lojaId == lojaId;
    }

    function franqueadoPodeCriarAcessoEstabelecimento() {
      return franqueadoAtivo()
        && request.resource.data.keys().hasOnly(['perfil','franquiaId','lojaId','ativo','email','nome','criadoEm'])
        && request.resource.data.perfil == 'estabelecimento'
        && request.resource.data.franquiaId == minhaFranquiaFranqueado()
        && request.resource.data.lojaId is string
        && request.resource.data.ativo == true
        && request.resource.data.email is string
        && request.resource.data.nome is string
        && existsAfter(/databases/$(database)/documents/franquias/$(request.resource.data.franquiaId)/estabelecimentos/$(request.resource.data.lojaId));
    }

    match /usuariosEstabelecimentos/{uid} {
      allow read: if
        (signedIn() && request.auth.uid == uid)
        || (franqueadoAtivo()
          && resource.data.franquiaId == minhaFranquiaFranqueado());
      allow update: if franqueadoPodeAlternarAcessoEstabelecimento();
      allow create: if franqueadoPodeCriarAcessoEstabelecimento();
      allow delete: if false;
    }

    match /usuariosEntregadores/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    match /franqueados/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    match /franquias/{fid} {
      allow read: if franqueadoDaFranquia(fid);
      allow write: if false;

      match /estabelecimentos/{lojaId} {
        allow read: if souDonoDaLoja(fid, lojaId)
          || entregadorDaFranquia(fid)
          || franqueadoDaFranquia(fid);
        allow create: if franqueadoPodeCriarEstabelecimento(fid, lojaId);
        allow update, delete: if false;

        match /pedidos/{pedidoId} {
          allow read: if souDonoDaLoja(fid, lojaId)
            || entregadorDaFranquia(fid)
            || franqueadoDaFranquia(fid);

          allow update: if
            (souDonoDaLoja(fid, lojaId)
              && somenteStatusFoiAlterado()
              && transicaoStatusEstabelecimentoValida())
            || (entregadorDaFranquia(fid) && transicaoEntregadorValida());

          allow create, delete: if false;
        }
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
