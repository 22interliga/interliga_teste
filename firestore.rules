rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn(){return request.auth!=null;}
    function estabelecimentoDoc(){return get(/databases/$(database)/documents/usuariosEstabelecimentos/$(request.auth.uid));}
    function entregadorDoc(){return get(/databases/$(database)/documents/usuariosEntregadores/$(request.auth.uid));}
    function franqueadoDoc(){return get(/databases/$(database)/documents/franqueados/$(request.auth.uid));}
    function clienteDoc(){return get(/databases/$(database)/documents/clientes/$(request.auth.uid));}
    function adminMasterDoc(){return get(/databases/$(database)/documents/adminsMaster/$(request.auth.uid));}
    function estabelecimentoAtivo(){return signedIn()&&estabelecimentoDoc().data.perfil=='estabelecimento'&&estabelecimentoDoc().data.ativo==true;}
    function entregadorAtivo(){return signedIn()&&entregadorDoc().data.perfil=='entregador'&&entregadorDoc().data.ativo==true;}
    function franqueadoAtivo(){return signedIn()&&franqueadoDoc().data.perfil=='franqueado'&&franqueadoDoc().data.ativo==true;}
    function adminMasterAtivo(){return signedIn()&&adminMasterDoc().data.perfil=='adminMaster'&&adminMasterDoc().data.ativo==true;}
    function clienteAnonimo(){return signedIn()&&request.auth.token.firebase.sign_in_provider=='anonymous';}
    function clienteCadastrado(){return signedIn()&&request.auth.token.firebase.sign_in_provider!='anonymous'&&clienteDoc().data.perfil=='cliente'&&clienteDoc().data.ativo==true;}
    function minhaFranquiaEstabelecimento(){return estabelecimentoAtivo()?estabelecimentoDoc().data.franquiaId:null;}
    function minhaLoja(){return estabelecimentoAtivo()?estabelecimentoDoc().data.lojaId:null;}
    function minhaFranquiaEntregador(){return entregadorAtivo()?entregadorDoc().data.franquiaId:null;}
    function minhaFranquiaFranqueado(){return franqueadoAtivo()?franqueadoDoc().data.franquiaId:null;}
    function souDonoDaLoja(fid,lojaId){return estabelecimentoAtivo()&&minhaFranquiaEstabelecimento()==fid&&minhaLoja()==lojaId;}
    function entregadorDaFranquia(fid){return entregadorAtivo()&&minhaFranquiaEntregador()==fid;}
    function entregadorPodeLerPedido(fid){return entregadorDaFranquia(fid)&&(resource.data.status=='Pronto'||(resource.data.keys().hasAny(['entregador'])&&resource.data.entregador.uid==request.auth.uid));}
    function franqueadoDaFranquia(fid){return franqueadoAtivo()&&minhaFranquiaFranqueado()==fid;}
    function clienteEhDonoDoPedido(){return signedIn()&&resource.data.clienteUid==request.auth.uid&&(clienteAnonimo()||clienteCadastrado());}
    function somenteStatusFoiAlterado(){return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);}
    function transicaoStatusEstabelecimentoValida(){return ((resource.data.status=='Novo'||resource.data.status=='Pendente')&&request.resource.data.status=='Confirmado')||(resource.data.status=='Confirmado'&&request.resource.data.status=='Em preparo')||(resource.data.status=='Em preparo'&&request.resource.data.status=='Pronto');}
    function cancelamentoEstabelecimentoValido(){return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','motivoCancelamento','canceladoPor','canceladoEm'])&&request.resource.data.motivoCancelamento is string&&request.resource.data.motivoCancelamento.size()>=3&&request.resource.data.motivoCancelamento.size()<=300&&request.resource.data.canceladoPor==request.auth.uid&&request.resource.data.canceladoEm==request.time&&(((resource.data.status=='Novo'||resource.data.status=='Pendente')&&request.resource.data.status=='Recusado')||(resource.data.status=='Confirmado'&&request.resource.data.status=='Cancelado'));}
    function cancelamentoClienteValido(){return clienteCadastrado()&&resource.data.clienteUid==request.auth.uid&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','motivoCancelamento','canceladoPor','canceladoEm'])&&request.resource.data.motivoCancelamento is string&&request.resource.data.motivoCancelamento.size()>=3&&request.resource.data.motivoCancelamento.size()<=300&&request.resource.data.canceladoPor==request.auth.uid&&request.resource.data.canceladoEm==request.time&&(resource.data.status=='Novo'||resource.data.status=='Confirmado')&&request.resource.data.status=='Cancelado';}
    function coordenadasLojaValidas(){return (!request.resource.data.keys().hasAny(['latitudeLoja','longitudeLoja'])||(request.resource.data.latitudeLoja is number&&request.resource.data.latitudeLoja>=-90&&request.resource.data.latitudeLoja<=90&&request.resource.data.longitudeLoja is number&&request.resource.data.longitudeLoja>=-180&&request.resource.data.longitudeLoja<=180));}
    function camposOperacionaisLojaValidos(){return request.resource.data.aceitandoPedidos is bool&&request.resource.data.categoria is string&&request.resource.data.categoria.size()>=2&&request.resource.data.categoria.size()<=100&&request.resource.data.telefoneLoja is string&&request.resource.data.telefoneLoja.size()<=30&&request.resource.data.enderecoLoja is string&&request.resource.data.enderecoLoja.size()<=220&&request.resource.data.horarioAbertura is string&&request.resource.data.horarioAbertura.size()<=5&&request.resource.data.horarioFechamento is string&&request.resource.data.horarioFechamento.size()<=5&&request.resource.data.taxaEntrega is number&&request.resource.data.taxaEntrega>=0&&request.resource.data.taxaEntrega<=10000&&request.resource.data.raioEntregaKm is number&&request.resource.data.raioEntregaKm>=0&&request.resource.data.raioEntregaKm<=500&&coordenadasLojaValidas();}
    function configuracaoOperacionalLojaValida(fid,lojaId){return souDonoDaLoja(fid,lojaId)&&camposOperacionaisLojaValidos()&&((request.resource.data.diff(resource.data).affectedKeys().hasOnly(['latitudeLoja','longitudeLoja','localizacaoAtualizadaEm'])&&request.resource.data.latitudeLoja is number&&request.resource.data.longitudeLoja is number&&request.resource.data.localizacaoAtualizadaEm==request.time)||(request.resource.data.diff(resource.data).affectedKeys().hasOnly(['aceitandoPedidos','categoria','telefoneLoja','enderecoLoja','horarioAbertura','horarioFechamento','taxaEntrega','raioEntregaKm','operacaoAtualizadaEm'])&&request.resource.data.operacaoAtualizadaEm==request.time));}
    function comissaoInterfoodFranqueadoValida(fid){return franqueadoDaFranquia(fid)&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(['taxaComissaoInterfood','taxaComissaoInterfoodAtualizadaEm','taxaComissaoInterfoodAtualizadaPor'])&&request.resource.data.taxaComissaoInterfood is number&&request.resource.data.taxaComissaoInterfood>=0&&request.resource.data.taxaComissaoInterfood<=100&&request.resource.data.taxaComissaoInterfoodAtualizadaEm==request.time&&request.resource.data.taxaComissaoInterfoodAtualizadaPor==request.auth.uid;}
    function entregadorEhOAutenticado(){return request.resource.data.entregador.uid==request.auth.uid;}
    function pedidoJaEhMeu(){return resource.data.entregador.uid==request.auth.uid;}
    function transicaoEntregadorValida(){return (resource.data.status=='Pronto'&&request.resource.data.status=='Entregador aceitou'&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','entregador','aceitoEm'])&&entregadorEhOAutenticado())||(resource.data.status=='Entregador aceitou'&&request.resource.data.status=='Coletado'&&pedidoJaEhMeu()&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','coletadoEm']))||(resource.data.status=='Coletado'&&request.resource.data.status=='Saiu para entrega'&&pedidoJaEhMeu()&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','saiuEntregaEm']))||(resource.data.status=='Saiu para entrega'&&request.resource.data.status=='Concluído'&&pedidoJaEhMeu()&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','concluidoEm']));}
    function desistirEntregaValido(){return resource.data.status=='Entregador aceitou'&&pedidoJaEhMeu()&&request.resource.data.status=='Pronto'&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','entregador','motivoDesistenciaEntrega','desistiuEntregaEm'])&&!request.resource.data.keys().hasAny(['entregador'])&&request.resource.data.motivoDesistenciaEntrega is string&&request.resource.data.motivoDesistenciaEntrega.size()>=3&&request.resource.data.motivoDesistenciaEntrega.size()<=300&&request.resource.data.desistiuEntregaEm==request.time;}
    function incidenteEntregaValido(){return pedidoJaEhMeu()&&(resource.data.status=='Coletado'||resource.data.status=='Saiu para entrega')&&request.resource.data.status==resource.data.status&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(['incidenteEntrega','incidenteEntregaEm'])&&request.resource.data.incidenteEntrega.uid==request.auth.uid&&request.resource.data.incidenteEntrega.nome is string&&request.resource.data.incidenteEntrega.motivo is string&&request.resource.data.incidenteEntrega.motivo.size()>=3&&request.resource.data.incidenteEntrega.motivo.size()<=300&&request.resource.data.incidenteEntrega.statusNoMomento==resource.data.status&&request.resource.data.incidenteEntregaEm==request.time;}
    function gestaoOcorrenciaFranqueadoValida(fid){return franqueadoDaFranquia(fid)&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(['gestaoOcorrencia','gestaoOcorrenciaAtualizadaEm'])&&request.resource.data.gestaoOcorrencia.status is string&&(request.resource.data.gestaoOcorrencia.status=='Em análise'||request.resource.data.gestaoOcorrencia.status=='Resolvida')&&request.resource.data.gestaoOcorrencia.providencia is string&&request.resource.data.gestaoOcorrencia.providencia.size()>=3&&request.resource.data.gestaoOcorrencia.providencia.size()<=500&&request.resource.data.gestaoOcorrencia.franqueadoUid==request.auth.uid&&request.resource.data.gestaoOcorrenciaAtualizadaEm==request.time&&((resource.data.keys().hasAny(['motivoDesistenciaEntrega'])&&resource.data.motivoDesistenciaEntrega is string)||(resource.data.keys().hasAny(['motivoDesistencia'])&&resource.data.motivoDesistencia is string)||(resource.data.keys().hasAny(['incidenteEntrega'])&&resource.data.incidenteEntrega.motivo is string));}
    function franqueadoPodeAlternarAcessoEstabelecimento(){return franqueadoAtivo()&&resource.data.franquiaId==minhaFranquiaFranqueado()&&request.resource.data.franquiaId==resource.data.franquiaId&&request.resource.data.lojaId==resource.data.lojaId&&request.resource.data.perfil==resource.data.perfil&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ativo'])&&request.resource.data.ativo is bool;}
    function franqueadoPodeCriarEstabelecimento(fid,lojaId){return franqueadoDaFranquia(fid)&&request.resource.data.keys().hasOnly(['nome','email','ativo','franquiaId','lojaId','criadoEm'])&&request.resource.data.nome is string&&request.resource.data.email is string&&request.resource.data.ativo==true&&request.resource.data.franquiaId==fid&&request.resource.data.lojaId==lojaId;}
    function franqueadoPodeCriarAcessoEstabelecimento(){return franqueadoAtivo()&&request.resource.data.keys().hasOnly(['perfil','franquiaId','lojaId','ativo','email','nome','criadoEm'])&&request.resource.data.perfil=='estabelecimento'&&request.resource.data.franquiaId==minhaFranquiaFranqueado()&&request.resource.data.lojaId is string&&request.resource.data.ativo==true&&request.resource.data.email is string&&request.resource.data.nome is string&&existsAfter(/databases/$(database)/documents/franquias/$(request.resource.data.franquiaId)/estabelecimentos/$(request.resource.data.lojaId));}
    function clientePodeCriarPerfil(uid){return signedIn()&&request.auth.uid==uid&&request.auth.token.firebase.sign_in_provider!='anonymous'&&request.resource.data.keys().hasOnly(['nome','telefone','email','ativo','perfil','criadoEm'])&&request.resource.data.nome is string&&request.resource.data.nome.size()>=2&&request.resource.data.nome.size()<=120&&request.resource.data.telefone is string&&request.resource.data.telefone.size()<=30&&request.resource.data.email==request.auth.token.email&&request.resource.data.ativo==true&&request.resource.data.perfil=='cliente'&&request.resource.data.criadoEm==request.time;}
    function clientePodeAtualizarPerfil(uid){return clienteCadastrado()&&request.auth.uid==uid&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nome','telefone','atualizadoEm'])&&request.resource.data.nome is string&&request.resource.data.nome.size()>=2&&request.resource.data.nome.size()<=120&&request.resource.data.telefone is string&&request.resource.data.telefone.size()<=30&&request.resource.data.atualizadoEm==request.time;}
    function coordenadasEnderecoValidas(){return (!request.resource.data.keys().hasAny(['latitude','longitude'])||(request.resource.data.latitude is number&&request.resource.data.latitude>=-90&&request.resource.data.latitude<=90&&request.resource.data.longitude is number&&request.resource.data.longitude>=-180&&request.resource.data.longitude<=180));}
    function camposEnderecoValidos(){return request.resource.data.apelido is string&&request.resource.data.apelido.size()>=2&&request.resource.data.apelido.size()<=60&&request.resource.data.cep is string&&request.resource.data.cep.size()<=12&&request.resource.data.logradouro is string&&request.resource.data.logradouro.size()>=4&&request.resource.data.logradouro.size()<=220&&request.resource.data.bairro is string&&request.resource.data.bairro.size()<=100&&request.resource.data.cidade is string&&request.resource.data.cidade.size()>=2&&request.resource.data.cidade.size()<=100&&request.resource.data.uf is string&&request.resource.data.uf.size()==2&&request.resource.data.complemento is string&&request.resource.data.complemento.size()<=120&&request.resource.data.principal is bool&&coordenadasEnderecoValidas();}
    function enderecoClienteCriacaoValida(){return request.resource.data.keys().hasOnly(['apelido','cep','logradouro','bairro','cidade','uf','complemento','principal','criadoEm','latitude','longitude','localizacaoAtualizadaEm'])&&camposEnderecoValidos()&&request.resource.data.criadoEm==request.time&&(!request.resource.data.keys().hasAny(['localizacaoAtualizadaEm'])||request.resource.data.localizacaoAtualizadaEm==request.time);}
    function enderecoClienteAtualizacaoValida(){return request.resource.data.keys().hasOnly(['apelido','cep','logradouro','bairro','cidade','uf','complemento','principal','criadoEm','atualizadoEm','latitude','longitude','localizacaoAtualizadaEm'])&&camposEnderecoValidos()&&request.resource.data.criadoEm==resource.data.criadoEm&&request.resource.data.atualizadoEm==request.time&&(!request.resource.data.diff(resource.data).affectedKeys().hasAny(['latitude','longitude','localizacaoAtualizadaEm'])||request.resource.data.localizacaoAtualizadaEm==request.time);}
    function cardapioValido(){return request.resource.data.keys().hasOnly(['nome','categoria','descricao','preco','ativo','criadoEm','atualizadoEm','variacoes','gruposAdicionais'])&&request.resource.data.nome is string&&request.resource.data.nome.size()>=2&&request.resource.data.nome.size()<=160&&request.resource.data.categoria is string&&request.resource.data.categoria.size()>=2&&request.resource.data.categoria.size()<=100&&request.resource.data.descricao is string&&request.resource.data.descricao.size()<=500&&request.resource.data.preco is number&&request.resource.data.preco>=0&&request.resource.data.preco<=100000&&request.resource.data.ativo is bool&&(!request.resource.data.keys().hasAny(['variacoes'])||request.resource.data.variacoes is list)&&(!request.resource.data.keys().hasAny(['gruposAdicionais'])||request.resource.data.gruposAdicionais is list);}
    function categoriaCardapioValida(){return request.resource.data.keys().hasOnly(['nome','ordem','ativo','criadoEm','atualizadoEm'])&&request.resource.data.nome is string&&request.resource.data.nome.size()>=2&&request.resource.data.nome.size()<=100&&request.resource.data.ordem is int&&request.resource.data.ordem>=1&&request.resource.data.ordem<=999&&request.resource.data.ativo is bool;}

    match /adminsMaster/{uid}{allow read:if signedIn()&&request.auth.uid==uid;allow write:if false;}
    match /auditoriaInterfood/{eventoId}{allow read:if adminMasterAtivo();allow write:if false;}
    match /clientes/{uid}{allow create:if clientePodeCriarPerfil(uid);allow read:if signedIn()&&request.auth.uid==uid;allow update:if clientePodeAtualizarPerfil(uid);allow delete:if false;match /enderecos/{enderecoId}{allow read:if clienteCadastrado()&&request.auth.uid==uid;allow create:if clienteCadastrado()&&request.auth.uid==uid&&enderecoClienteCriacaoValida();allow update:if clienteCadastrado()&&request.auth.uid==uid&&enderecoClienteAtualizacaoValida();allow delete:if clienteCadastrado()&&request.auth.uid==uid;}}
    match /usuariosEstabelecimentos/{uid}{allow read:if (signedIn()&&request.auth.uid==uid)||(franqueadoAtivo()&&resource.data.franquiaId==minhaFranquiaFranqueado())||adminMasterAtivo();allow update:if franqueadoPodeAlternarAcessoEstabelecimento();allow create:if franqueadoPodeCriarAcessoEstabelecimento();allow delete:if false;}
    match /usuariosEntregadores/{uid}{allow read:if (signedIn()&&request.auth.uid==uid)||adminMasterAtivo();allow write:if false;}
    match /franqueados/{uid}{allow read:if (signedIn()&&request.auth.uid==uid)||adminMasterAtivo();allow write:if false;}
    match /franquias/{fid}{
      allow read: if franqueadoDaFranquia(fid)||adminMasterAtivo();
      allow create,delete: if false;
      allow update: if adminMasterAtivo()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'nome',
          'cidade',
          'nomeApp',
          'nomeInterfood',
          'corPrimaria',
          'corDestaque',
          'corFundo',
          'coresAreas',
          'modulos',
          'identidadeAtualizadaEm',
          'identidadeAtualizadaPor'
        ])
        && request.resource.data.nomeApp is string
        && request.resource.data.nomeInterfood is string
        && request.resource.data.corPrimaria is string
        && request.resource.data.corDestaque is string
        && request.resource.data.corFundo is string
        && request.resource.data.coresAreas is map
        && request.resource.data.modulos is map
        && request.resource.data.identidadeAtualizadaEm == request.time
        && request.resource.data.identidadeAtualizadaPor == request.auth.uid;
match /estabelecimentos/{lojaId}{allow read:if souDonoDaLoja(fid,lojaId)||entregadorDaFranquia(fid)||franqueadoDaFranquia(fid)||clienteCadastrado()||adminMasterAtivo();allow create:if franqueadoPodeCriarEstabelecimento(fid,lojaId);allow update:if configuracaoOperacionalLojaValida(fid,lojaId)||comissaoInterfoodFranqueadoValida(fid);allow delete:if false;
      match /cardapio/{produtoId}{allow read:if souDonoDaLoja(fid,lojaId)||franqueadoDaFranquia(fid)||clienteCadastrado()||adminMasterAtivo();allow create:if souDonoDaLoja(fid,lojaId)&&cardapioValido()&&request.resource.data.criadoEm==request.time&&request.resource.data.atualizadoEm==request.time;allow update:if souDonoDaLoja(fid,lojaId)&&cardapioValido()&&request.resource.data.criadoEm==resource.data.criadoEm&&request.resource.data.atualizadoEm==request.time;allow delete:if false;}
      match /categoriasCardapio/{categoriaId}{allow read:if souDonoDaLoja(fid,lojaId)||franqueadoDaFranquia(fid)||clienteCadastrado()||adminMasterAtivo();allow create:if souDonoDaLoja(fid,lojaId)&&categoriaCardapioValida()&&request.resource.data.criadoEm==request.time&&request.resource.data.atualizadoEm==request.time;allow update:if souDonoDaLoja(fid,lojaId)&&categoriaCardapioValida()&&request.resource.data.criadoEm==resource.data.criadoEm&&request.resource.data.atualizadoEm==request.time;allow delete:if false;}
      match /pedidos/{pedidoId}{allow read:if souDonoDaLoja(fid,lojaId)||entregadorPodeLerPedido(fid)||franqueadoDaFranquia(fid)||clienteEhDonoDoPedido()||adminMasterAtivo();allow create:if false;allow update:if (souDonoDaLoja(fid,lojaId)&&((somenteStatusFoiAlterado()&&transicaoStatusEstabelecimentoValida())||cancelamentoEstabelecimentoValido()))||(entregadorDaFranquia(fid)&&(transicaoEntregadorValida()||desistirEntregaValido()||incidenteEntregaValido()))||gestaoOcorrenciaFranqueadoValida(fid)||cancelamentoClienteValido();allow delete:if false;}
      match /estatisticas/{docId}{allow read:if souDonoDaLoja(fid,lojaId)||franqueadoDaFranquia(fid)||adminMasterAtivo();allow write:if false;}

    }
      match /fechamentosInterfood/{fechamentoId}{
        allow read:if souDonoDaLoja(fid,resource.data.lojaId);
        allow create,update,delete:if false;
      }
    }

    // ============================================================
    // MOBILIDADE — HOMOLOGACAO
    // Regras endurecidas em 2026-09-16
    // Mantido separado das regras do Interfood.
    // ============================================================

    match /corridas/{corridaId} {

      // Corridas aguardando ficam visiveis aos motoristas autenticados.
      // Depois do aceite, somente participantes e gestores.
      allow read: if signedIn() && (
        resource.data.status == 'aguardando' ||
        request.auth.uid == resource.data.passageiroId ||
        request.auth.uid == resource.data.motoristaId ||
        adminMasterAtivo() ||
        franqueadoAtivo()
      );

      // Passageiro cria somente corrida propria e inicialmente aguardando.
      allow create: if signedIn()
        && request.resource.data.passageiroId == request.auth.uid
        && request.resource.data.status == 'aguardando'
        && !request.resource.data.keys().hasAny([
          'motoristaId',
          'motoristaNome',
          'motoristaVeiculo',
          'motoristaPlaca',
          'motoristaAvaliacao',
          'motoristaSelfie',
          'motoristaLat',
          'motoristaLon'
        ]);

      // Passageiro dono:
      // mantém identidade da corrida e não pode se atribuir como motorista.
      //
      // Motorista:
      // pode operar corrida aguardando ou já atribuída a ele.
      //
      // Gestores:
      // mantidos para operação administrativa da homologação.
      allow update: if signedIn() && (

        (
          request.auth.uid == resource.data.passageiroId
          && request.resource.data.passageiroId == resource.data.passageiroId

          // Passageiro pode apenas inicializar/avancar a fila de oferta
          // enquanto a corrida continua aguardando.
          // Ele nunca atribui motoristaId por este caminho.
          && resource.data.status == 'aguardando'
          && request.resource.data.status == 'aguardando'
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly([
                 'filaMotoristas',
                 'filaIndiceAtual',
                 'motoristaAlvoAtual',
                 'ofertaExpiraEm',
                 'rodadaFila'
               ])
        )

        ||

        (
          // Passageiro pode encerrar a própria busca somente após
          // permanecer aguardando, sem atribuir ou alterar motorista.
          request.auth.uid == resource.data.passageiroId
          && resource.data.status == 'aguardando'
          && request.resource.data.status == 'sem_motorista'
          && request.resource.data.passageiroId == resource.data.passageiroId
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly([
                 'status',
                 'buscaEncerradaEm'
               ])
        )

        ||

        (
          (
            (
              resource.data.status == 'aguardando'
              && (
                !resource.data.keys().hasAny(['motoristaAlvoAtual'])
                || resource.data.motoristaAlvoAtual == request.auth.uid
              )
              && request.resource.data.motoristaId == request.auth.uid
              && (
                request.resource.data.status == 'aceita'
                || request.resource.data.status == 'reservada'
              )
            )

            ||

            (
              // Recusa/rotação da oferta:
              // o motorista alvo pode apenas devolver a corrida para a fila,
              // sem assumir a corrida e sem alterar dados de negócio.
              resource.data.status == 'aguardando'
              && resource.data.keys().hasAny(['motoristaAlvoAtual'])
              && resource.data.motoristaAlvoAtual == request.auth.uid
              && request.resource.data.status == 'aguardando'
              && request.resource.data.motoristaId == resource.data.motoristaId
              && request.resource.data.diff(resource.data).affectedKeys()
                   .hasOnly([
                     'recusantes',
                     'filaIndiceAtual',
                     'motoristaAlvoAtual',
                     'ofertaExpiraEm'
                   ])
            )

            ||

            (
              request.auth.uid == resource.data.motoristaId
              && request.resource.data.motoristaId == resource.data.motoristaId

              // Depois que a corrida pertence ao motorista,
              // somente transições operacionais conhecidas são aceitas.
              && (
                (
                  resource.data.status == 'reservada'
                  && request.resource.data.status == 'aceita'
                )
                ||
                (
                  resource.data.status == 'aceita'
                  && (
                    request.resource.data.status == 'aceita'
                    || request.resource.data.status == 'em_andamento'
                    || request.resource.data.status == 'cancelada'
                  )
                )
                ||
                (
                  resource.data.status == 'em_andamento'
                  && (
                    request.resource.data.status == 'em_andamento'
                    || request.resource.data.status == 'finalizada'
                    || request.resource.data.status == 'cancelada'
                  )
                )
              )
            )
          )
          &&
          request.resource.data.passageiroId == resource.data.passageiroId
        )

        ||

        adminMasterAtivo()
        ||

        franqueadoAtivo()
      );

      allow delete: if false;

      match /mensagens/{mensagemId} {
        allow read, write: if signedIn() && (
          request.auth.uid ==
            get(/databases/$(database)/documents/corridas/$(corridaId)).data.passageiroId ||
          request.auth.uid ==
            get(/databases/$(database)/documents/corridas/$(corridaId)).data.motoristaId ||
          adminMasterAtivo() ||
          franqueadoAtivo()
        );
      }
    }

    match /motoristas/{motoristaId} {
      allow read: if signedIn();

      allow create: if signedIn()
        && request.auth.uid == motoristaId;

      allow update: if signedIn() && (
        request.auth.uid == motoristaId ||
        adminMasterAtivo() ||
        franqueadoAtivo()
      );

      allow delete: if adminMasterAtivo();
    }

    match /passageiros/{uid} {
      allow read: if signedIn();

      allow create: if signedIn()
        && request.auth.uid == uid;

      allow update: if signedIn() && (
        request.auth.uid == uid ||
        adminMasterAtivo() ||
        franqueadoAtivo()
      );

      allow delete: if false;
    }

    match /motoristas_disponiveis/{motoristaId} {
      allow read: if signedIn();

      allow create, update, delete: if signedIn()
        && request.auth.uid == motoristaId;
    }

    match /motoristas_proxima_corrida/{motoristaId} {
      allow read: if signedIn();

      allow create, update, delete: if signedIn()
        && request.auth.uid == motoristaId;
    }

    match /precos/{cidadeId} {
      allow read: if signedIn();
      allow write: if adminMasterAtivo() || franqueadoAtivo();
    }

    match /categorias_veiculo/{catId} {
      allow read: if signedIn();
      allow write: if adminMasterAtivo() || franqueadoAtivo();
    }

    match /{document=**}{allow read,write:if false;}
  }
}
